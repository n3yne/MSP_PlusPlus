{
  "name": "msp-pp",
  "version": "0.8.9",
  "description": "MSP++: a wrapper for MSP and ticketing sites with a plugin side panel and ticket note backup",
  "main": "src/main/main.js",
  "scripts": {
    "start": "node scripts/launch.js",
    "lint": "eslint .",
    "test": "jest",
    "build": "node scripts/build-native.js && electron-builder --win",
    "build-portable": "node scripts/build-native.js && electron-builder --win portable",
    "build-installer": "node scripts/build-native.js && electron-builder --win nsis",
    "build-mac": "electron-builder --mac",
    "build-native": "node scripts/build-native.js",
    "build-store": "node scripts/build-native.js && electron-builder --win appx"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.0.0",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "node-gyp": "^12.4.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/test/**/*.test.js"
    ],
    "moduleNameMapper": {
      "^electron$": "<rootDir>/test/electron-stub.js"
    }
  },
  "build": {
    "appId": "com.n3yne.freshservicepp",
    "productName": "MSP++",
    "asarUnpack": [
      "native/windows-hello/build/Release/*.node",
      "native/windows-sso/build/Release/*.node",
      "native/windows-clipboard/build/Release/*.node"
    ],
    "files": [
      "src/**/*",
      "assets/icon.png",
      "native/windows-hello/index.js",
      "native/windows-hello/package.json",
      "native/windows-hello/build/Release/*.node",
      "native/windows-sso/index.js",
      "native/windows-sso/package.json",
      "native/windows-sso/build/Release/*.node",
      "native/windows-clipboard/index.js",
      "native/windows-clipboard/package.json",
      "native/windows-clipboard/build/Release/*.node"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "selectPerMachineByDefault": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "MSP-PlusPlus-Setup-${version}.${ext}",
      "shortcutName": "MSP++",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "appx": {
      "identityName": "MSPPlusPlus.PLACEHOLDER",
      "publisher": "CN=00000000-0000-0000-0000-000000000000",
      "publisherDisplayName": "PLACEHOLDER",
      "applicationId": "MSPPlusPlus",
      "displayName": "MSP++",
      "backgroundColor": "transparent",
      "languages": [
        "en-US"
      ],
      "minVersion": "10.0.18362.0",
      "addAutoLaunchExtension": false,
      "electronUpdaterAware": false,
      "artifactName": "MSP-PlusPlus-Store-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.business"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "n3yne",
        "repo": "MSP_PlusPlus",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "dist"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
